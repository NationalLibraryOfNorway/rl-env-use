# This fork defaults to self-hosted models and local browsing. No hosted keys required.
RLENV_OPEN_ONLY=1
RLENV_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
# Must match the model IDs exposed by your server's /v1/models endpoint.
RLENV_LOCAL_TEXT_MODEL=Qwen/Qwen3-VL-8B-Instruct
RLENV_LOCAL_BROWSER_MODEL=Qwen/Qwen3-VL-8B-Instruct
# Optional separate server for the local-browser alias:
# RLENV_LOCAL_BROWSER_BASE_URL=http://127.0.0.1:8001/v1
# Optional token configured on your own server (not a hosted-provider API key):
RLENV_LOCAL_API_KEY=
RLENV_LOCAL_MAX_TOKENS=262144
RLENV_LOCAL_TIMEOUT=1200
# Minimal smoke-test panel; configure multiple independent open models for real evals.
RLENV_PANEL_MODELS=local-text
# Point explicitly to an installed open-source Chromium build:
# RLENV_BROWSER_EXECUTABLE=/usr/bin/chromium

# Set to 0 for text-only browser models (DOM navigation without screenshots).
RLENV_BROWSER_USE_VISION=1

# Optional named routes, each with its own endpoint and raw served model ID.
# Use --writer local:writer --critic local:critic (also valid in panels and policies).
# RLENV_LOCAL_MODELS={"writer":{"model":"writer-model-id","base_url":"http://127.0.0.1:8000/v1"},"critic":{"model":"critic-model-id","base_url":"http://127.0.0.1:8001/v1","api_key_env":"CRITIC_SERVER_TOKEN"}}
# CRITIC_SERVER_TOKEN=your-endpoint-token

# Artifact languages: ISO 639-3 (eng=English, nob=Bokmål, nno=Nynorsk, spa=Spanish).
# Per-environment --language overrides this default and is saved in spec.json.
RLENV_LANGUAGE=eng
# Also localize model feedback, mining notes, critiques and explicit reasoning:
RLENV_LOCALIZE_DIAGNOSTICS=0
RLENV_STEP_TIMEOUT=360
RLENV_MISSION_TIMEOUT=3000
RLENV_GLOBAL_TIMEOUT=0

# Optional DeepInfra open-weight hosted routes. Merge these entries into your
# existing RLENV_LOCAL_MODELS object; do not add a second active definition.
# Uses Authorization: Bearer automatically. Fill in the raw key only.
DEEPINFRA_API_KEY=
# RLENV_LOCAL_MODELS={"deepinfra-deepseek-writer":{"model":"deepseek-ai/DeepSeek-V4.1-Flash-1017","base_url":"https://api.deepinfra.com/v1/openai","api_key_env":"DEEPINFRA_API_KEY"},"deepinfra-deepseek-critic":{"model":"deepseek-ai/DeepSeek-V4.1-Flash","base_url":"https://api.deepinfra.com/v1/openai","api_key_env":"DEEPINFRA_API_KEY"},"deepinfra-nemotron-writer":{"model":"nvidia/NVIDIA-Nemotron-3.5-Super-VL","base_url":"https://api.deepinfra.com/v1/openai","api_key_env":"DEEPINFRA_API_KEY"},"deepinfra-nemotron-critic":{"model":"nvidia/NVIDIA-Nemotron-3.5-Lightning","base_url":"https://api.deepinfra.com/v1/openai","api_key_env":"DEEPINFRA_API_KEY"}}

# Bounded task critic: overrides general model limits only during task reviews.
RLENV_CRITIC_CALL_TIMEOUT=120
RLENV_CRITIC_TASK_TIMEOUT=360
RLENV_CRITIC_RETRIES=2
RLENV_CRITIC_MAX_TOKENS=4096
